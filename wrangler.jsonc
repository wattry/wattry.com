{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wattry-api-com",
  "account_id": "47e3faccce876684f7fe752fe5e04d31",
  "main": "workers/src/worker.js",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wattry_typetest",
      "database_id": "ca8db1d5-6fe5-417f-b17b-3dd52d2cbcde"
    }
  ],
  "ratelimits": [
    {
      "name": "SCORE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 1,
        "period": 60
      }
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-07-02",
  "routes": [
    {
      "pattern": "api.wattry.com",
      "zone_name": "wattry.com",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}